# Copy to .env for local dev. Gitignored. Never commit real tokens; never
# paste them in chat. In production these come from a k8s Secret (envFrom).

MATRIX_HOMESERVER=https://matrix.besson.tech/
MATRIX_TOKEN=            # this bot's own account access token
OPENROUTER_API_KEY=      # the only LLM credential; copied into every room's pod
ROOMS_NAMESPACE=coding-agent-rooms
RUNNER_IMAGE=ghcr.io/lab3ss/coding-agent-runner:0.2.2
IDLE_TEARDOWN_HOURS=24

# Turn guardrails (all optional, defaults shown; 0 disables a guardrail)
TURN_WATCHDOG_MINUTES=15 # abort a turn with no SSE activity this long (approval waits exempt)
TURN_MAX_HOURS=4         # absolute turn duration cap
SESSION_COST_CAP_USD=10  # session-cost circuit-breaker against a looping agent

# Local dev note: src/k8s.ts calls kc.loadFromCluster(), which only works
# inside a real pod. Running the broker outside the cluster requires either
# a kubeconfig-based alternative or just testing against the deployed pod.
