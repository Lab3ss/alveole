# Docker compose user: copy to .env and edit following README instructions,
# then start the compose stack (README §A)
# vs.
# A production k8s deployment injects the same variables from a Secret
# (envFrom) instead and never reads this file.

# ---- Deployment mode -------------------------------------------------------
# COMPOSE_PROFILES decides which services `docker compose` brings up:
#   matrix-included → homeserver (continuwuity) + Element Web + bootstrap + broker
#                     (batteries-included: use sections 1, 2 and 4)
#   (commented out) → broker only, against your own homeserver (sections 1, 2, 3)
# Defaults to matrix-included, so it is listed in section 4 below.
# Comment out this line if you already have a Matrix homeserver (see section 3).
COMPOSE_PROFILES=matrix-included


# ---- 1. OpenRouter (the LLM provider) --------------------------------------
# The single LLM credential, copied into every room's runner; never shared
# between rooms. Required.
OPENROUTER_API_KEY=


# ---- 2. Runners (the per-room workspaces) ----------------------------------
# Driver that provisions a workspace per room: "compose" (per-room containers)
# or "k8s" (per-room pods, requires the broker to run in-cluster). The compose
# stack sets this itself; it only matters to `npm run broker`, which loads this
# file.
WORKSPACE_BACKEND=compose
# Runner image: the throwaway container each room gets. The compose stack
# defaults to a locally built tag (README §A.3); pin a published tag to skip
# that local build.
RUNNER_IMAGE=ghcr.io/lab3ss/alveole-runner:0.3.0
# Per-runner resources (compose mode; mirrors the k8s pod limits).
RUNNER_MEM=2g
RUNNER_CPUS=2
# Idle threshold before a room is torn down automatically, in hours.
IDLE_TEARDOWN_HOURS=24
# Namespace holding the per-room pods (k8s backend only).
ROOMS_NAMESPACE=alveole-rooms
# Turn guardrails (all optional, defaults shown; 0 disables a guardrail)
# TURN_WATCHDOG_MINUTES: abort a turn with no SSE activity this long (approval waits exempt)
# TURN_MAX_HOURS: absolute turn duration cap
# SESSION_COST_CAP_USD: session-cost circuit-breaker against a looping agent
TURN_WATCHDOG_MINUTES=15
TURN_MAX_HOURS=4
SESSION_COST_CAP_USD=10


# ---- 3. Matrix — external homeserver (COMPOSE_PROFILES commented out) ------
# Use this when Matrix is already part of your life: the broker signs in as a
# dedicated bot account on your homeserver and joins rooms like any other user.
# Leave both empty to use the included homeserver instead (section 4).
# MATRIX_HOMESERVER: URL of your homeserver, e.g. https://matrix.example.org
# MATRIX_TOKEN: access token for the bot's account on it (Element: Settings →
# Help & About → Access Token)
#
# NOTE: keep values and comments on separate lines. `docker compose --env-file`
# does NOT strip inline comments — `MATRIX_HOMESERVER=  # foo` sets the value to
# "# foo", which makes the broker treat it as a homeserver URL and crash-loop.
MATRIX_HOMESERVER=
MATRIX_TOKEN=

# End-to-end encryption (applies to both homeserver modes). On by default: the
# bot decrypts and encrypts encrypted rooms, using a Rust crypto store that must
# persist across restarts. Set MATRIX_E2EE=false to opt out (unencrypted rooms
# only). MATRIX_CRYPTO_STORE overrides the store's directory; by default it sits
# next to the registry DB (REGISTRY_DB_PATH), i.e. /data/crypto-store in compose.
MATRIX_E2EE=true
MATRIX_CRYPTO_STORE=


# ---- 4. Matrix — included homeserver (COMPOSE_PROFILES=matrix-included) ----
# The batteries-included path: a full continuwuity homeserver + Element Web,
# plus a one-shot bootstrap that registers the bot and your accounts and
# creates the shared room. Comment out COMPOSE_PROFILES to turn all of this
# off and use section 3 instead.
# Registration token for the included homeserver. Optional: leave empty to use
# the built-in local default. Set a custom one only if you want to — generate it
# with: openssl rand -hex 12 (keep it secret).
REGISTRATION_TOKEN=
# URL browsers use to reach the homeserver (Element loads this). http://
# localhost:8008 works on the docker host; set it to the server's LAN address
# (e.g. http://192.168.1.10:8008) to chat from your phone — and keep
# MATRIX_SERVER_NAME equal to its host part.
HOMESERVER_PUBLIC_URL=http://localhost:8008
MATRIX_SERVER_NAME=localhost
# Bind addresses: only Element (8080) is meant for other devices; the
# homeserver (8008) must stay on loopback in matrix-included mode.
HOMESERVER_BIND=127.0.0.1
ELEMENT_BIND=0.0.0.0
# Name of the shared Matrix room the bootstrap creates for you.
ALVEOLE_ROOM_NAME=unicorn-project
# Bot account. ALVEOLE_BOT_USER is the Matrix localpart (valid usernames only:
# lowercase letters, digits, and ._=/- — no spaces); ALVEOLE_BOT_DISPLAY_NAME is
# what Element shows for the bot.
ALVEOLE_BOT_USER=coding-agent
ALVEOLE_BOT_DISPLAY_NAME=Coding Agent


# k8s note: src/k8s.ts calls kc.loadFromCluster(), which only works inside a
# real pod. Running the broker outside the cluster requires cluster access
# (see README §B), so the k8s backend is best tested against a deployed pod.
