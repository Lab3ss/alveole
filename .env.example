# Copy to .env for local dev. Gitignored. Never commit real tokens; never
# paste them in chat. In production these come from a k8s Secret (envFrom).

MATRIX_HOMESERVER=https://matrix.besson.tech/
MATRIX_TOKEN=            # this bot's own account access token
OPENROUTER_API_KEY=      # the only LLM credential; copied into every room's pod
ROOMS_NAMESPACE=coding-agent-rooms
RUNNER_IMAGE=ghcr.io/lab3ss/coding-agent-runner:0.3.0
IDLE_TEARDOWN_HOURS=24

# ---- docker-compose deployment (deploy/docker-compose.yml) -----------------
# Driver: "k8s" (default, per-room pods) or "compose" (per-room containers,
# see src/docker.ts). The compose file sets this itself; only override here
# for running `npm run broker` against docker.
WORKSPACE_BACKEND=k8s

# Which services come up. "bundled" = homeserver (continuwuity) + Element Web
# + bootstrap + broker. Empty string = external Matrix homeserver of your
# choice: only the broker runs, with MATRIX_HOMESERVER/MATRIX_TOKEN above.
COMPOSE_PROFILES=bundled

# Registration token for the bundled homeserver: registration only works with
# a token, and the bootstrap uses it to create the bot + your account.
# Generate one: openssl rand -hex 12
REGISTRATION_TOKEN=

# URL browsers use to reach the homeserver (Element loads this). http://
# localhost:8008 works on the docker host; set it to the server's LAN address
# (e.g. http://192.168.1.10:8008) to chat from your phone — and keep
# MATRIX_SERVER_NAME equal to its host part.
HOMESERVER_PUBLIC_URL=http://localhost:8008
MATRIX_SERVER_NAME=localhost
# Bind addresses: only Element (8080) is meant for other devices; the
# homeserver (8008) must stay on loopback in bundled mode.
HOMESERVER_BIND=127.0.0.1
ELEMENT_BIND=0.0.0.0

# Name of the shared Matrix room the bootstrap creates for you.
ALVEOLE_ROOM_NAME=Alvéole

# Runner container resources (compose mode; mirrors the k8s pod limits).
RUNNER_MEM=2g
RUNNER_CPUS=2

# Turn guardrails (all optional, defaults shown; 0 disables a guardrail)
TURN_WATCHDOG_MINUTES=15 # abort a turn with no SSE activity this long (approval waits exempt)
TURN_MAX_HOURS=4         # absolute turn duration cap
SESSION_COST_CAP_USD=10  # session-cost circuit-breaker against a looping agent

# Local dev note: src/k8s.ts calls kc.loadFromCluster(), which only works
# inside a real pod. Running the broker outside the cluster requires either
# a kubeconfig-based alternative or just testing against the deployed pod.
